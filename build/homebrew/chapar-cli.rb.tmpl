# Generated by build/homebrew/render-formula.sh when a release is published;
# edit the template in chapar-rest/chapar, not this file.
class ChaparCli < Formula
  desc "Run Chapar API test cases from the command-line"
  homepage "https://github.com/chapar-rest/chapar"
  version "{{VERSION}}"
  license "BSD-3-Clause"

  on_macos do
    on_arm do
      url "https://github.com/chapar-rest/chapar/releases/download/v{{VERSION}}/chapar-cli-macos-v{{VERSION}}-arm64.tar.gz"
      sha256 "{{SHA_MACOS_ARM64}}"
    end
    on_intel do
      url "https://github.com/chapar-rest/chapar/releases/download/v{{VERSION}}/chapar-cli-macos-v{{VERSION}}-amd64.tar.gz"
      sha256 "{{SHA_MACOS_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/chapar-rest/chapar/releases/download/v{{VERSION}}/chapar-cli-linux-v{{VERSION}}-arm64.tar.gz"
      sha256 "{{SHA_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/chapar-rest/chapar/releases/download/v{{VERSION}}/chapar-cli-linux-v{{VERSION}}-amd64.tar.gz"
      sha256 "{{SHA_LINUX_AMD64}}"
    end
  end

  def install
    bin.install "chapar-cli"
  end

  test do
    assert_match "chapar-cli v#{version}", shell_output("#{bin}/chapar-cli version")
  end
end
